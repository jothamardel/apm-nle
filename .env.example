# Leave these blank to run immediately in Interactive Demo Mode locally.
# Populate them with your Supabase & Paystack keys to activate live production.

NEXT_PUBLIC_SITE_URL=https://www.nlegrassroots.org

# Supabase (https://supabase.com/dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Paystack (https://dashboard.paystack.com/#/settings/developers)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# Optional: Custom INEC dataset JSON/CSV URL for scripts/seed-inec-locations.ts
INEC_DATASET_URL=

